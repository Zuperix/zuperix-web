lication support"}],"servers":[],"components":{"securitySchemes":{"JWT":{"scheme":"bearer","bearerFormat":"JWT","type":"http","description":"Enter the JWT token obtained from /auth/login"}},"schemas":{"RegisterDto":{"type":"object","properties":{"email":{"type":"string","example":"jane@example.com","description":"User email address"},"password":{"type":"string","example":"supersecret123","description":"Password (min 8 characters)","minLength":8},"name":{"type":"string","example":"Jane Doe","description":"Display name"},"companyName":{"type":"string","example":"Acme Corp","description":"Company name"}},"required":["email","password","name","companyName"]},"LoginDto":{"type":"object","properties":{"email":{"type":"string","example":"jane@example.com","description":"User email address"},"password":{"type":"string","example":"supersecret123","description":"Account password"}},"required":["email","password"]},"UpdateUserDto":{"type":"object","properties":{"name":{"type":"string","example":"Jane Smith","description":"New display name"},"email":{"type":"string","example":"jane.smith@example.com","description":"New email address"}}},"CreateWorkspaceDto":{"type":"object","properties":{"name":{"type":"string","example":"My Brand Assets","description":"Human-readable workspace name"}},"required":["name"]},"CreateMetadataFieldDto":{"type":"object","properties":{"groupId":{"type":"string","description":"Group this field belongs to","example":"uuid-of-group"},"key":{"type":"string","description":"Machine-readable field key (unique per workspace)","example":"photographer","maxLength":128},"label":{"type":"string","description":"Human-readable display label","example":"Photographer Name","maxLength":256},"fieldType":{"type":"string","description":"Type of this metadata field","enum":["string","text","integer","float","boolean","date","datetime","enum","multi_select","json","url","email","reference"],"example":"string"},"options":{"type":"object","description":"Options for enum/multi_select (choices array) or reference (target model)","example":{"choices":["Nike","Adidas","Puma"]}},"validationRules":{"type":"object","description":"Validation rules: min, max, pattern, required, choices","example":{"min":0,"max":1000000}},"isSearchable":{"type":"boolean","description":"Index this field for search","default":false},"isRequired":{"type":"boolean","description":"Make this field required","default":false},"defaultValue":{"type":"object","description":"Default value (type-agnostic)","example":"Unknown"},"sortOrder":{"type":"number","description":"Display order within its group","example":0}},"required":["key","label","fieldType"]},"UpdateMetadataFieldDto":{"type":"object","properties":{"groupId":{"type":"string","description":"Group this field belongs to","example":"uuid-of-group"},"key":{"type":"string","description":"Machine-readable field key (unique per workspace)","example":"photographer","maxLength":128},"label":{"type":"string","description":"Human-readable display label","example":"Photographer Name","maxLength":256},"fieldType":{"type":"string","description":"Type of this metadata field","enum":["string","text","integer","float","boolean","date","datetime","enum","multi_select","json","url","email","reference"],"example":"string"},"options":{"type":"object","description":"Options for enum/multi_select (choices array) or reference (target model)","example":{"choices":["Nike","Adidas","Puma"]}},"validationRules":{"type":"object","description":"Validation rules: min, max, pattern, required, choices","example":{"min":0,"max":1000000}},"isSearchable":{"type":"boolean","description":"Index this field for search","default":false},"isRequired":{"type":"boolean","description":"Make this field required","default":false},"defaultValue":{"type":"object","description":"Default value (type-agnostic)","example":"Unknown"},"sortOrder":{"type":"number","description":"Display order within its group","example":0}}},"CreateMetadataGroupDto":{"type":"object","properties":{"name":{"type":"string","description":"Group name","example":"Photography Metadata","maxLength":128},"description":{"type":"string","description":"Optional description shown in the UI","example":"Camera, lens, and shoot settings"},"sortOrder":{"type":"number","description":"Display order (lower = first)","example":1}},"required":["name"]},"CreateMetadataTemplateDto":{"type":"object","properties":{"name":{"type":"string","description":"Template name","example":"Product Photography Template","maxLength":256},"description":{"type":"string","description":"Template description","example":"Standard fields for product shoot assets"},"fieldIds":{"description":"Ordered list of MetadataFieldDefinition UUIDs in this template","example":["uuid-1","uuid-2","uuid-3"],"type":"array","items":{"type":"string"}}},"required":["name","fieldIds"]},"MetadataEntryDto":{"type":"object","properties":{"fieldId":{"type":"string","description":"UUID of the MetadataFieldDefinition","example":"uuid-of-field"},"value":{"type":"object","description":"Value to set — type must match the field type","example":"Annie Leibovitz"}},"required":["fieldId","value"]},"SetAssetMetadataDto":{"type":"object","properties":{"entries":{"description":"Array of field ID + value pairs to upsert on this asset","type":"array","items":{"$ref":"#/components/schemas/MetadataEntryDto"}}},"required":["entries"]},"BulkTagDto":{"type":"object","properties":{"tags":{"description":"Tag names to add or remove. Will be normalized (lowercase, trimmed).","example":["summer_campaign","product_launch","hero-shot"],"type":"array","items":{"type":"string"}}},"required":["tags"]},"IngestAiMetadataDto":{"type":"object","properties":{"provider":{"type":"string","description":"AI provider name","example":"google_vision","maxLength":64},"modelVersion":{"type":"string","description":"Model or API version used","example":"v1p3beta1","maxLength":64},"labels":{"description":"Object detection or classification labels","example":["dog","outdoor","park"],"type":"array","items":{"type":"string"}},"ocrText":{"type":"string","description":"OCR-extracted text content","example":"SALE 50% OFF"},"colorPalette":{"description":"Dominant color palette (hex codes)","example":["#FF5733","#1ABC9C"],"type":"array","items":{"type":"string"}},"sceneTags":{"description":"Scene classification tags","example":["beach","sunset","travel"],"type":"array","items":{"type":"string"}},"confidenceScores":{"type":"object","description":"Confidence scores per label","example":{"dog":0.98,"outdoor":0.75}},"rawResponse":{"type":"object","description":"Full raw provider response (preserved for reprocessing)"}},"required":["provider"]}}}}